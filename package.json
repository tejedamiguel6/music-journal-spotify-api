{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "test-db": "tsx -r tsconfig-paths/register script/test-db.ts",
    "cf-export": "npx dotenv-cli -- contentful space export --management-token $CONTENTFUL_MANAGEMENT_TOKEN --space-id k64k3kt74fyv --environment-id master --content-file export.json --export-dir contentful-export --download-assets",
    "check-env": "npx dotenv-cli -- sh -c 'echo $CONTENTFUL_ACCESS_TOKEN && echo $CONTENTFUL_SPACE_ID'",
    "cf-generate-types": "cf-content-types-generator contentful-export/export.json --out types/contentful",
    "graphql-codegen": "graphql-codegen"
  },
  "dependencies": {
    "@contentful/node-apps-toolkit": "^3.13.0",
    "@contentful/rich-text-react-renderer": "^16.0.1",
    "@opennextjs/cloudflare": "^1.10.1",
    "clsx": "^2.1.1",
    "contentful-migration": "^4.27.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.6",
    "next": "^15.5.7",
    "node-cache": "^5.1.2",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-react-apollo": "^4.3.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cf-content-types-generator": "^2.16.1",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsconfig": "^7.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "wrangler": "^4.42.2"
  }
}
